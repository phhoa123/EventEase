@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | EventEase</PageTitle>

<section class="container py-5 text-center" aria-labelledby="not-found-title">
    <p class="text-primary fw-semibold text-uppercase small">404 error</p>
    <h1 class="display-5 fw-bold" id="not-found-title">Page not found</h1>
    <p class="mx-auto my-3 text-secondary" style="max-width: 32rem;">
        The page you are looking for doesn't exist or may have moved.
    </p>
    <NavLink class="btn btn-primary mt-2" href="/events">
        Browse events
    </NavLink>
</section>
