@page "/events/{Slug}"
@rendermode InteractiveServer
@using System.Globalization
@using EventEase.Components.Models

<PageTitle>@(EventItem is null ? "Event not found | EventEase" : $"{EventItem.Name} | EventEase")</PageTitle>

@if (EventItem is null)
{
    <section class="container event-not-found py-5">
        <p class="eyebrow">EVENT NOT FOUND</p>
        <h1 class="h2">We couldn't find that event</h1>
        <p class="text-secondary">It may have been removed or the link may be incorrect.</p>
        <NavLink class="btn btn-outline-primary" href="/events">Back to events</NavLink>
    </section>
}
else
{
    <section class="container-fluid event-details-page" aria-labelledby="event-title">
        <NavLink class="details-back-link d-inline-flex align-items-center gap-1 mb-3" href="/events">
            <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="m12.5 4-6 6 6 6" />
            </svg>
            All events
        </NavLink>

        <header class="details-hero rounded-4 @EventItem.ArtClass">
            <div class="details-hero__content">
                <span class="event-card__art-label">@EventItem.Category</span>
                <h1 id="event-title">@EventItem.Name</h1>
                <p>@EventItem.ArtTitle</p>
            </div>
            <span class="details-hero__mark" aria-hidden="true">@EventItem.ArtMark</span>
        </header>

        <div class="row g-4 details-layout">
            <div class="col-lg-8 details-main">
                <section class="details-section mb-4 pb-4 border-bottom" aria-labelledby="about-heading">
                    <p class="eyebrow">ABOUT THIS EVENT</p>
                    <h2 class="h4" id="about-heading">An experience worth sharing</h2>
                    <p class="details-description">@EventItem.Description</p>
                </section>

                <section class="details-section details-highlights" aria-labelledby="highlights-heading">
                    <p class="eyebrow">WHAT TO EXPECT</p>
                    <h2 class="h4" id="highlights-heading">Event highlights</h2>
                    <ul class="list-group list-group-flush mt-3">
                        @foreach (var highlight in EventItem.Highlights)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2 px-0 py-2 bg-transparent">
                                <span class="highlight-check" aria-hidden="true">
                                    <svg viewBox="0 0 20 20">
                                        <path d="m5 10 3.2 3.2L15.5 6" />
                                    </svg>
                                </span>
                                @highlight
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <aside class="col-lg-4 details-sidebar" aria-label="Event information">
                <section class="card border-0 shadow-sm event-info-card" aria-labelledby="event-info-heading">
                    <div class="card-body">
                        <h2 class="h5" id="event-info-heading">Event information</h2>
                        <div class="event-info-item d-flex align-items-start gap-2 py-3 border-top">
                            <span class="event-info-item__icon" aria-hidden="true">
                                <svg viewBox="0 0 20 20">
                                    <rect x="3" y="4.5" width="14" height="13" rx="2" />
                                    <path d="M6.5 2.5v4M13.5 2.5v4M3 8.5h14" />
                                </svg>
                            </span>
                            <span class="d-flex flex-column gap-1">
                                <small class="text-secondary">Date</small>
                                <strong class="fw-semibold">@EventItem.Date.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)</strong>
                            </span>
                        </div>
                    <div class="event-info-item d-flex align-items-start gap-2 py-3 border-top">
                        <span class="event-info-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <circle cx="10" cy="10" r="7" />
                                <path d="M10 6v4l2.5 1.5" />
                            </svg>
                        </span>
                        <span class="d-flex flex-column gap-1">
                            <small class="text-secondary">Time</small>
                            <strong class="fw-semibold">@EventItem.Time</strong>
                        </span>
                    </div>
                    <div class="event-info-item d-flex align-items-start gap-2 py-3 border-top">
                        <span class="event-info-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <path d="M16 8.3c0 4.2-6 9.2-6 9.2S4 12.5 4 8.3a6 6 0 1 1 12 0Z" />
                                <circle cx="10" cy="8" r="2" />
                            </svg>
                        </span>
                        <span class="d-flex flex-column gap-1">
                            <small class="text-secondary">Venue</small>
                            <strong class="fw-semibold">@EventItem.Venue</strong>
                            <small class="text-secondary">@EventItem.Address</small>
                        </span>
                    </div>
                    <div class="event-info-item d-flex align-items-start gap-2 py-3 border-top">
                        <span class="event-info-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <circle cx="7" cy="7" r="3" />
                                <path d="M2.5 17v-1.5A4.5 4.5 0 0 1 7 11h1a4.5 4.5 0 0 1 4.5 4.5V17M13 4.5a3 3 0 0 1 0 5.8M15 11a3.5 3.5 0 0 1 2.5 3.4V17" />
                            </svg>
                        </span>
                        <span class="d-flex flex-column gap-1">
                            <small class="text-secondary">Who should attend</small>
                            <strong class="fw-semibold">@EventItem.Audience</strong>
                        </span>
                    </div>
                    <div class="event-info-item d-flex align-items-start gap-2 py-3 border-top">
                        <span class="event-info-item__icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20">
                                <path d="M4 17V4l6-2v15M10 7h6v10M2 17h16M6.5 6.5h1M6.5 9.5h1M6.5 12.5h1M12.5 10h1M12.5 13h1" />
                            </svg>
                        </span>
                        <span class="d-flex flex-column gap-1">
                            <small class="text-secondary">Capacity</small>
                            <strong class="fw-semibold">@EventItem.Capacity</strong>
                        </span>
                    </div>

                    <NavLink class="btn btn-primary w-100 register-button"
                             href="@($"/events/{EventItem.Slug}/register")">
                        Register
                        <svg viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M3.5 10h13M11 4.5l5.5 5.5-5.5 5.5" />
                        </svg>
                    </NavLink>
                    <p class="registration-caption text-secondary">Registration takes just a minute</p>
                    </div>
                </section>
            </aside>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private EventItem? EventItem => EventCatalog.Find(Slug);
}
